{
  "manifest_version": 2,
  "version": "1.0",
  "name": "Desktop theme",
  "description": "Follows the color theme of the desktop, sent by the dotfiles' theme command.",
  "permissions": ["theme", "nativeMessaging"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-desktop-theme@karasibille",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
